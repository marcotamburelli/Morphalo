#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/venv/bin/python"

SPEC="$1"
shift || true

if [ -t 0 ]; then
  # stdin è terminale → image deve essere passato come argomento
  IMAGE="$1"
  shift || true
else
  # stdin pipe → leggiamo JSON e estraiamo .image
  IMAGE="$(jq -r '.image' < /dev/stdin)"
fi

exec "$PY" -m stability.cli.main i2i "$SPEC" "$IMAGE" "$@"
